
# ADVANCED ASSIGNMENT - 2D LIDAR SENSOR VISUALIZATION

import numpy as np
import matplotlib.pyplot as plt
from matplotlib.patches import Circle

# STEP 1: Set LiDAR sensor settings
np.random.seed(42)
NUM_ANGLES = 360
MAX_RANGE = 5.0
NEARBY_DISTANCE = 1.5

angles = np.radians(np.arange(NUM_ANGLES))

# STEP 2: Define surrounding obstacles (x, y, radius)
obstacles = [
    (2,1,0.35), (3.5,2,0.45), (-2,2.5,0.4),
    (-3.5,-1,0.5), (1,-2.5,0.45), (-1,-3.5,0.4),
    (4,-1,0.35), (-2.5,-2,0.5), (0.5,3.5,0.4),
    (3,-3,0.45)
]

# STEP 3: Simulate 360 LiDAR distance measurements
distances = np.full(NUM_ANGLES, MAX_RANGE)
detected = np.zeros(NUM_ANGLES, dtype=bool)

for i, angle in enumerate(angles):
    dx, dy = np.cos(angle), np.sin(angle)

    for ox, oy, radius in obstacles:
        projection = dx*ox + dy*oy
        disc = projection**2 - (ox**2 + oy**2 - radius**2)

        if disc >= 0:
            distance = projection - np.sqrt(disc)

            if 0 < distance <= distances[i]:
                distances[i] = np.clip(
                    distance + np.random.normal(0, 0.015),
                    0, MAX_RANGE
                )
                detected[i] = True

# STEP 4: Convert polar coordinates into Cartesian coordinates
x = distances * np.cos(angles)
y = distances * np.sin(angles)

# STEP 5: Identify nearby obstacles
nearby = detected & (distances <= NEARBY_DISTANCE)
detected_count = np.sum(detected)
nearby_count = np.sum(nearby)

min_distance = np.min(distances[detected]) if detected_count else MAX_RANGE

# STEP 6: Display LiDAR sensor information
print("="*45)
print("       2D LIDAR SENSOR ANALYSIS")
print("="*45)
print("Sensor Status: CONNECTED")
print("Angular Measurements:", NUM_ANGLES)
print("Maximum Sensor Range:", MAX_RANGE, "meters")
print("Detected Points:", detected_count)
print("Nearby Obstacles:", nearby_count)
print("Nearest Obstacle Distance:", round(min_distance,2), "meters")
print("Robot Position: (0, 0)")
print("Scanning Coverage: 360 degrees")
print("="*45)

# STEP 7: Create professional dark dashboard
fig = plt.figure(figsize=(13,9))
fig.patch.set_facecolor("#171923")

fig.text(0.5,0.96,"2D LiDAR SENSOR VISUALIZATION",
         ha="center",fontsize=19,fontweight="bold",color="white")

fig.text(0.5,0.92,"Autonomous Robot | 360 Degree Environment Scanning",
         ha="center",fontsize=10,color="#A0AEC0")

# Display sensor statistics
for xpos, label, value, color in [
    (0.20,"MEASUREMENTS",NUM_ANGLES,"#63B3ED"),
    (0.50,"MAX RANGE",f"{MAX_RANGE} m","#68D391"),
    (0.80,"DETECTED POINTS",detected_count,"#F6AD55")
]:
    fig.text(xpos,0.86,f"{label}\n{value}",ha="center",
             fontsize=12,color=color,fontweight="bold")

# STEP 8: Create LiDAR scanning graph
ax = fig.add_axes([0.08,0.10,0.84,0.68])
ax.set_facecolor("#050505")

# Draw distance circles and coordinate axes
for r in range(1,6):
    ax.add_patch(Circle((0,0),r,fill=False,
                        color="#555555",linewidth=0.8,alpha=0.8))
    ax.text(r,0.08,f"{r}m",color="#AAAAAA",fontsize=8)

ax.axhline(0,color="#777777",linewidth=0.8)
ax.axvline(0,color="#777777",linewidth=0.8)

# STEP 9: Plot detected LiDAR points and nearby obstacles
ax.scatter(x[detected],y[detected],s=15,color="#7CFF9B",
           label="LiDAR Points",alpha=0.95)

ax.scatter(x[nearby],y[nearby],s=35,color="#FF5252",
           edgecolors="white",linewidths=0.4,
           label="Nearby Obstacles",zorder=5)

# STEP 10: Display robot at the origin
ax.add_patch(Circle((0,0),0.12,color="#FF5252",zorder=8))
ax.arrow(0,0,0,0.35,color="#FF5252",width=0.025,
         head_width=0.12,head_length=0.12,zorder=9)

ax.text(0.15,0.18,"ROBOT",color="white",
        fontsize=9,fontweight="bold")

# Draw obstacle boundaries
for ox,oy,radius in obstacles:
    ax.add_patch(Circle((ox,oy),radius,fill=False,
                        edgecolor="#FFB74D",linewidth=1,
                        linestyle="--",alpha=0.6))

# STEP 11: Format the graph and display information
ax.set(xlim=(-5,5),ylim=(-5,5),
       xlabel="X Position (meters)",
       ylabel="Y Position (meters)",
       title="GLOBAL LIDAR SCAN MAP")

ax.set_aspect("equal")
ax.tick_params(colors="#BBBBBB")
ax.xaxis.label.set_color("white")
ax.yaxis.label.set_color("white")
ax.title.set_color("white")
ax.title.set_fontsize(13)
ax.title.set_fontweight("bold")

for spine in ax.spines.values():
    spine.set_color("#555555")

# Display legend
legend = ax.legend(loc="upper right",facecolor="#252A34",
                   edgecolor="#555555",fontsize=9)

for text in legend.get_texts():
    text.set_color("white")

# Display scanning information
ax.text(-4.8,4.5,"STATUS: CONNECTED\nSCAN: 360 DEGREES\nGRID: 1m INTERVALS",
        color="#68D391",fontsize=9,fontweight="bold",
        verticalalignment="top")

# Display final LiDAR visualization
plt.show()
